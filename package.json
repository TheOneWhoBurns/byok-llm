{
  "name": "byok-llm",
  "version": "1.0.0",
  "description": "Bring Your Own Key — unified API key management for AI-powered apps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "typecheck": "tsc -p tsconfig.eslint.json",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "byok",
    "bring-your-own-key",
    "api-key",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "openrouter",
    "claude",
    "gpt",
    "gemini",
    "groq"
  ],
  "license": "MIT",
  "author": "Andres Sol Martinez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOneWhoBurns/byok-llm.git"
  },
  "homepage": "https://github.com/TheOneWhoBurns/byok-llm#readme",
  "bugs": {
    "url": "https://github.com/TheOneWhoBurns/byok-llm/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
